{
  "name": "app/estacionamento",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "Projeto/src/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public public/index.php",
    "lint": "phpcs --standard=PSR12 Projeto/src public"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
